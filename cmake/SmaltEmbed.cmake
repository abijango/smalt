# smalt_embed_resources(<output header> <file>...)
#
# Writes a C header with each file as a byte array and the
# `nh_embedded_resources` table that toolchains/nickelhook/resources.c seeds
# on user storage. Modelled on Kobalt's platforms/kobo/CMakeLists.txt (MIT,
# see toolchains/LICENSE.kobalt). Used by src/nickel/ and by the desktop test
# of the seeding logic.
function(smalt_embed_resources output)
    set(embedded "// Generated by cmake/SmaltEmbed.cmake. Do not edit.\n#include <resources.h>\n")
    set(table "static const struct nh_resource nh_embedded_resources[] = {\n")
    foreach(path IN LISTS ARGN)
        get_filename_component(name "${path}" NAME)
        string(MAKE_C_IDENTIFIER "${name}" id)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(READ "${path}" bytes HEX)
        string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
        string(APPEND embedded "static const unsigned char resource_${id}[] = {${bytes}};\n")
        string(APPEND table "    {\"${name}\", resource_${id}, sizeof(resource_${id})},\n")
    endforeach()
    string(APPEND table "    {NULL, NULL, 0}};\n")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${embedded}${table}" @ONLY)
endfunction()
